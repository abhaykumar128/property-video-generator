# ─── Dependencies ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Environment variables (NEVER commit real keys) ─────────────
.env
.env.local
.env.*.local

# ─── Build outputs ───────────────────────────────────────────────
dist/
build/
frontend/dist/

# ─── Runtime uploads and generated videos ────────────────────────
backend/uploads/*
backend/outputs/*
