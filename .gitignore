!backend/uploads/.gitkeep
!backend/outputs/.gitkeep

# ─── Logs ────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ─── OS / Editor ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# ─── Test coverage ───────────────────────────────────────────────
coverage/
.nyc_output/
