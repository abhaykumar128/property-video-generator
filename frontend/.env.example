# ─────────────────────────────────────────────────────────────────
# Frontend environment variables (Vite)
# Copy this file to .env and adjust if needed.
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put secrets here — this file is bundled into the client.
# ─────────────────────────────────────────────────────────────────

# Backend API base URL.
# In development the Vite proxy (vite.config.js) forwards /api and
# /outputs automatically, so this can be left empty.
# In production set it to the deployed backend URL, e.g.:
#   VITE_API_URL=https://your-backend.example.com
VITE_API_URL=
