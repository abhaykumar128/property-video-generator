# ─────────────────────────────────────────────────────────────────
# Backend environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# HTTP port the Express server listens on (default: 4000)
PORT=4000

# Allowed frontend origin for CORS (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# ── AI Script Generation ─────────────────────────────────────────
# Google Gemini API key — get one at https://aistudio.google.com/app/apikey
# Leave blank to use the built-in template-based fallback.
GEMINI_API_KEY=

# Gemini model name (default: gemini-1.5-flash)
# Other options: gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-flash-latest

# Gemini video generation model (used for AI video generation via Interactions API)
# Default: gemini-omni-1.1-flash
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash

# ── Video Rendering ───────────────────────────────────────────────
# FFmpeg is bundled via ffmpeg-static — no manual installation needed.
# Override the binary path only if you want to use a specific FFmpeg version.
# Example (Windows): FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# json2video API key — only needed if you switch the renderer back to the
# cloud-based json2video engine. Leave blank for local FFmpeg rendering.
JSON2VIDEO_API_KEY=

# ── File Storage ─────────────────────────────────────────────────
# Absolute path for uploaded images/audio (default: ./uploads)
UPLOAD_DIR=

# Absolute path for locally cached/downloaded MP4 files (default: ./outputs)
OUTPUT_DIR=

# Maximum size (in MB) for a single uploaded image (default: 10)
MAX_FILE_SIZE_MB=10

# Maximum size (in MB) for an uploaded audio file (default: 20)
MAX_AUDIO_SIZE_MB=20
